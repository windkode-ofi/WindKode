# WindKode — Variables de entorno
# Copia este archivo a `.env.local` (ignorado por git) si necesitas cambiar los valores.
# Ambas son opcionales: si faltan, se usan los valores de `src/config/contact.ts`.

# Correo que recibe las solicitudes del formulario y de los enlaces mailto:
VITE_CONTACT_EMAIL=windkode@gmail.com
# Número de WhatsApp en formato internacional sin "+" (Bolivia = 591)
VITE_WHATSAPP_NUMBER=59175904262

# --- Backend (solo servidor, función api/contact.ts) ---
# Bandeja que recibe las solicitudes del formulario
CONTACT_TO=windkode@gmail.com
# Cuenta Gmail que envía el correo (requiere verificación en 2 pasos)
GMAIL_USER=windkode@gmail.com
# Contraseña de aplicación: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
