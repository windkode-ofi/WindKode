{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "env": ["VITE_*"],
            "outputs": ["dist/**", "dist-ssr/**"]
        },
        "clean": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "dependsOn": ["^build"],
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "lint:fix": {
            "cache": false,
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^build"]
        }
    }
}
