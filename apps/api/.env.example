# ── Entorno ─────────────────────────────────────────────
# development | preview | production (el seed se niega a correr en production)
APP_ENV=development
PORT=4000

# ── Base de datos ───────────────────────────────────────
# Local: docker compose (pnpm db:up). En Supabase (botón "Connect" del proyecto):
#   DATABASE_URL = Transaction pooler (puerto 6543): la usa la api en runtime (serverless)
#   DIRECT_URL   = Session pooler (puerto 5432 del pooler, funciona con IPv4): migraciones y seed
DATABASE_URL=postgresql://windkode:windkode@localhost:5433/windkode
DIRECT_URL=postgresql://windkode:windkode@localhost:5433/windkode

# ── Auth ────────────────────────────────────────────────
# Secreto del access token (mínimo 32 caracteres): openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
# lax en local y con dominios propios (admin. y api. del mismo dominio); none en previews de vercel.app
COOKIE_SAME_SITE=lax

# ── CORS ────────────────────────────────────────────────
# Orígenes permitidos separados por coma (admin y web)
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# ── Seed ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@windkode.com
SEED_ADMIN_NAME=Admin WindKode
SEED_ADMIN_PASSWORD=cambia-esta-clave
