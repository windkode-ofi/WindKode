{
    "compilerOptions": {
        "noUncheckedIndexedAccess": true,
        "paths": { "~/*": ["./src/*"] },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "types": ["vite/client"]
    },
    "exclude": ["src/**/*.test.ts"],
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["src/**/*.ts", "src/**/*.vue"]
}
