{
    "name": "windkode",
    "version": "0.0.0",
    "private": true,
    "description": "Monorepo de WindKode: landing (web), panel interno (admin), API (api) y paquetes compartidos.",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "check": "turbo run lint typecheck && prettier --check .",
        "clean": "turbo run clean && rm -rf node_modules .turbo",
        "db:down": "docker compose -f apps/api/docker-compose.dev.yml down",
        "db:up": "docker compose -f apps/api/docker-compose.dev.yml up -d",
        "dev": "turbo run dev",
        "dev:admin": "turbo run dev --filter=@windkode/admin --filter=@windkode/shared",
        "dev:api": "turbo run dev --filter=@windkode/api --filter=@windkode/shared",
        "dev:local": "pnpm db:up && turbo run dev",
        "dev:web": "turbo run dev --filter=@windkode/web",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "fresh": "pnpm clean && pnpm install",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "prepare": "husky",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck"
    },
    "lint-staged": {
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ],
        "apps/admin/**/*.{ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "apps/api/**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "packages/**/*.{js,ts}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "eslint": "^10.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "prettier-plugin-css-order": "^2.2.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "turbo": "^2.11.7"
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=24.12.0",
        "pnpm": ">=10.33.0"
    }
}
