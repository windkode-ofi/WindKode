{
  "name": "windkode",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de WindKode: landing (web), panel interno (admin), API (api) y paquetes compartidos.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "dev:web": "turbo run dev --filter=@windkode/web",
    "fresh": "pnpm clean && pnpm install",
    "prepare": "husky",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.33.0"
  }
}
